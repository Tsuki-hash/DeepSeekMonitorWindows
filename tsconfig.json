{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  // 测试文件与 Node 类型垫片不进应用构建；测试引用 node: 内置模块，
  // 由 tsconfig.test.json 单独检查。共享纯函数可使用 .ts 后缀兼容 Node 类型剥离。
  "exclude": ["src/**/*.test.ts", "src/node-shims.d.ts"],
  "references": []
}
